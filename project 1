<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Aarav Sharma – Front-end developer</title>
<meta name="description" content="Personal site of Aarav Sharma, a front-end developer building accessible, responsive websites.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=Instrument+Sans:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#eef2f0; --surface:#ffffff; --ink:#14213d; --muted:#4a5670;
  --accent:#2b50ff; --accent-ink:#ffffff; --mark:#f4e85a; --line:#c9d3ce;
  --display:"Bricolage Grotesque","Trebuchet MS",system-ui,sans-serif;
  --body:"Instrument Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0f1624; --surface:#18223a; --ink:#e9eefb; --muted:#a3b0cc;
    --accent:#8fa6ff; --accent-ink:#0f1624; --mark:#f4e85a; --line:#2b3857;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0f1624; --surface:#18223a; --ink:#e9eefb; --muted:#a3b0cc;
  --accent:#8fa6ff; --accent-ink:#0f1624; --mark:#f4e85a; --line:#2b3857;
  color-scheme:dark;
}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.6 var(--body)}
a{color:inherit}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.wrap{width:min(100% - 2.5rem,68rem);margin-inline:auto}
.skip{position:absolute;left:-999px}
.skip:focus{left:1rem;top:1rem;background:var(--ink);color:var(--bg);padding:.5rem 1rem;z-index:5}

/* Header: Flexbox */
.site-header{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.75rem 2rem;padding-block:1.25rem}
.logo{font:800 1.25rem var(--display);text-decoration:none}
.site-header ul{display:flex;flex-wrap:wrap;gap:.25rem 1.5rem;list-style:none;margin:0;padding:0}
.site-header a{text-decoration:none;font-weight:600;padding:.25rem 0;border-bottom:2px solid transparent}
.site-header a:hover{border-color:var(--accent)}

/* Hero: Grid */
.hero{display:grid;grid-template-columns:1.6fr 1fr;gap:2.5rem 4rem;align-items:end;padding-block:clamp(3rem,9vw,7rem) clamp(3rem,7vw,5rem)}
.hero h1{font:800 clamp(3rem,9vw,6.5rem)/.95 var(--display);letter-spacing:-.03em;margin:0 0 1.5rem}
.hero h1 span{display:block}
.hero p{max-width:34rem;margin:0;font-size:1.2rem;color:var(--muted)}
mark{background:linear-gradient(transparent 55%,var(--mark) 55%);color:inherit}
.now{background:var(--surface);border:2px solid var(--ink);padding:1.5rem;border-radius:.25rem 1.5rem .25rem .25rem}
.now h2{font:800 1.1rem var(--display);margin:0 0 .75rem}
.now dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:.4rem 1rem}
.now dt{color:var(--muted)} .now dd{margin:0;font-weight:600}

section{padding-block:clamp(2.5rem,6vw,4.5rem);border-top:2px solid var(--ink)}
section>.wrap>h2{font:800 clamp(1.8rem,4vw,2.6rem)/1.1 var(--display);letter-spacing:-.02em;margin:0 0 .5rem}
.lede{color:var(--muted);margin:0 0 2rem;max-width:36rem}

/* About: Grid */
.about{display:grid;grid-template-columns:1fr 2fr;gap:1.5rem 4rem}
.about p{margin:0 0 1rem;max-width:40rem}

/* Skills: auto-fit Grid */
.skills{display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:2rem}
.skills h3{font:800 1.15rem var(--display);margin:0 0 .75rem}
.skills ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.5rem}
.skills li{border:1.5px solid var(--ink);border-radius:2rem;padding:.2rem .85rem;font-weight:600;font-size:.95rem}

/* Projects: Grid with a featured card */
.projects{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
.card{display:flex;flex-direction:column;gap:.75rem;background:var(--surface);border:2px solid var(--ink);padding:1.5rem}
.card:first-child{grid-column:span 3;flex-direction:row;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.card:first-child .tags{color:inherit}
.card h3{font:800 1.4rem/1.15 var(--display);margin:0}
.card p{margin:0;flex:1}
.card:first-child .body{flex:1 1 24rem;display:flex;flex-direction:column;gap:.75rem}
.tags{color:var(--muted);font-size:.9rem;margin:0}
.card a.go{font-weight:600;align-self:flex-start}
.card:first-child a.go{align-self:flex-end}

/* Contact: Flexbox */
.contact-list{display:flex;flex-wrap:wrap;gap:1rem;list-style:none;margin:0;padding:0}
.contact-list a{display:inline-block;text-decoration:none;font-weight:600;padding:.75rem 1.4rem;border:2px solid var(--ink)}
.contact-list li:first-child a{background:var(--ink);color:var(--bg)}
.contact-list a:hover{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.site-footer{padding-block:2rem;color:var(--muted);font-size:.95rem}

/* Responsive */
@media (max-width:860px){
  .hero,.about{grid-template-columns:1fr}
  .projects{grid-template-columns:1fr 1fr}
  .card:first-child{grid-column:span 2}
}
@media (max-width:560px){
  body{font-size:1rem}
  .projects{grid-template-columns:1fr}
  .card:first-child{grid-column:auto;flex-direction:column;align-items:stretch}
  .card:first-child a.go{align-self:flex-start}
  .contact-list a{display:block;text-align:center}
  .contact-list li{flex:1 1 100%}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="wrap site-header">
  <a class="logo" href="#top">Aarav Sharma</a>
  <nav aria-label="Main">
    <ul>
      <li><a href="#about">About</a></li>
      <li><a href="#skills">Skills</a></li>
      <li><a href="#projects">Projects</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>
</header>

<main id="main">
  <div class="wrap hero" id="top">
    <div>
      <h1><span>Hi, I’m Aarav.</span><span>I build <mark>clear</mark> websites.</span></h1>
      <p>I’m a front-end developer who turns designs into fast, accessible pages that work on any screen, from a small phone to a wide monitor.</p>
    </div>
    <aside class="now" aria-labelledby="now-h">
      <h2 id="now-h">Right now</h2>
      <dl>
        <dt>Role</dt><dd>Junior front-end developer</dd>
        <dt>Learning</dt><dd>TypeScript</dd>
        <dt>Open to</dt><dd>Internships and freelance work</dd>
      </dl>
    </aside>
  </div>

  <section id="about" aria-labelledby="about-h">
    <div class="wrap about">
      <h2 id="about-h">About me</h2>
      <div>
        <p>I started with a single HTML file and never stopped. I like pages that load quickly, read well and can be used with a keyboard as easily as with a mouse.</p>
        <p>Outside of code, I sketch interfaces on paper, play cricket on weekends and read about how everyday things are designed.</p>
      </div>
    </div>
  </section>

  <section id="skills" aria-labelledby="skills-h">
    <div class="wrap">
      <h2 id="skills-h">Skills</h2>
      <p class="lede">The tools I use most, grouped by what they do.</p>
      <div class="skills">
        <div><h3>Build</h3><ul><li>HTML5</li><li>CSS3</li><li>JavaScript</li><li>Flexbox</li><li>Grid</li></ul></div>
        <div><h3>Work</h3><ul><li>Git</li><li>GitHub</li><li>VS Code</li><li>npm</li></ul></div>
        <div><h3>Care</h3><ul><li>Accessibility</li><li>Responsive design</li><li>Performance</li></ul></div>
      </div>
    </div>
  </section>

  <section id="projects" aria-labelledby="projects-h">
    <div class="wrap">
      <h2 id="projects-h">Projects</h2>
      <p class="lede">Three small projects that show how I work. Replace the links with your own.</p>
      <div class="projects">
        <article class="card">
          <div class="body">
            <h3>Neighbourhood Market</h3>
            <p>A mobile-first shop page for a local vegetable seller, with a product grid that reflows from one column to four.</p>
            <p class="tags">HTML, CSS Grid, JavaScript</p>
          </div>
          <a class="go" href="#">View project</a>
        </article>
        <article class="card">
          <h3>Study Timer</h3>
          <p>A focus timer with keyboard shortcuts and a high-contrast dark theme.</p>
          <p class="tags">JavaScript, CSS variables</p>
          <a class="go" href="#">View project</a>
        </article>
        <article class="card">
          <h3>Recipe Cards</h3>
          <p>A printable recipe layout built with semantic markup and Flexbox.</p>
          <p class="tags">HTML5, Flexbox</p>
          <a class="go" href="#">View project</a>
        </article>
        <article class="card">
          <h3>Weather Glance</h3>
          <p>A one-screen forecast that fetches data from a public API.</p>
          <p class="tags">JavaScript, Fetch API</p>
          <a class="go" href="#">View project</a>
        </article>
      </div>
    </div>
  </section>

  <section id="contact" aria-labelledby="contact-h">
    <div class="wrap">
      <h2 id="contact-h">Contact</h2>
      <p class="lede">Have a project or an opportunity? Send me an email and I’ll reply within two days.</p>
      <ul class="contact-list">
        <li><a href="mailto:aarav@example.com">Email me</a></li>
        <li><a href="https://github.com/">GitHub</a></li>
        <li><a href="https://www.linkedin.com/">LinkedIn</a></li>
      </ul>
    </div>
  </section>
</main>

<footer class="wrap site-footer">
  <p>© 2026 Aarav Sharma. Built with HTML and CSS.</p>
</footer>
</body>
</html>
